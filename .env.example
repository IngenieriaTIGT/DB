# Base de datos
# Para desarrollo local con SQLite:
DATABASE_URL="file:./prisma/dev.db"

# Para producción con PostgreSQL (ejemplo):
# DATABASE_URL="postgresql://usuario:password@host:5432/nombre_base_datos"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="tu-clave-secreta-muy-segura-cambiar-en-produccion-32chars"

# Directorio de uploads
UPLOAD_DIR="./public/uploads"

# Opcional: Para envío de emails en producción
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="tu-email@example.com"
# SMTP_PASS="tu-password-smtp"
